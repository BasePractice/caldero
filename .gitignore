.idea
.pg
.prometheus
.bin

# Бинарники сервисов, собранные в корне: go build без -o кладёт их сюда,
# и в репозиторий они попадать не должны
/wallet
/credit
/account
/users
/notify
/wishlist
/caldron
/web
/bookgen

# Собранный веб-интерфейс: артефакт сборки на несколько мегабайт
services/cmd/web/static/app.wasm

# Собранный документ: артефакт, публикуется сборкой
docs/book/*.pdf
.logs
.env
.env.local

# Учётные данные для коллекций запросов
_requests/http-client.private.env.json

# Профиль покрытия: артефакт прогона тестов
.cover

# Следы выката: файл окружения сервера, копии скриптов и отметка
# о выкаченном теге появляются только на машине, где идёт выкат.
deploy/.deployed-tag
deploy/smoke.sh
deploy/config

# Артефакт сборки: `go build ./services/cmd/web/app` кладёт бинарник
# с именем каталога в корень репозитория.
/app
