{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "{{ env "KRAKEND_NAME" }}",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "@comment": "Заголовки клиента не проходят к бэкендам, если не перечислены в input_headers. X-Authorized-Id туда не входит намеренно: его проставляет только auth/validator из claim sub.",
  "endpoints": [
    {
      "@comment": "Публичный: регистрация пользователя",
      "endpoint": "/api/v1/register",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://users:51053"
          ],
          "url_pattern": "/register",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 5,
          "capacity": 5,
          "client_max_rate": 1,
          "client_capacity": 1,
          "strategy": "ip"
        }
      }
    },
    {
      "@comment": "Публичный: выдача токена",
      "endpoint": "/api/v1/token",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length",
        "Authorization"
      ],
      "backend": [
        {
          "host": [
            "{{ env "AUTH_HOST" }}"
          ],
          "url_pattern": "{{ env "AUTH_TOKEN_PATH" }}",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 10,
          "capacity": 10,
          "client_max_rate": 2,
          "client_capacity": 2,
          "strategy": "ip"
        }
      }
    },
    {
      "@comment": "Публичный: набор ключей для проверки подписи",
      "endpoint": "/api/v1/.well-known/jwks.json",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "{{ env "AUTH_HOST" }}"
          ],
          "url_pattern": "{{ env "AUTH_JWKS_PATH" }}",
          "encoding": "no-op"
        }
      ]
    },
    {
      "@comment": "Защищённый: создание кредита",
      "endpoint": "/api/v1/credit",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://credit:51052"
          ],
          "url_pattern": "/credit",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "@comment": "disable_jwk_security нужен, пока JWKS отдаётся по http внутри compose-сети. С TLS убрать.",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: график платежей по кредиту",
      "endpoint": "/api/v1/credits/{id}/schedule",
      "method": "GET",
      "backend": [
        {
          "host": [
            "http://credit:51052"
          ],
          "url_pattern": "/credits/{id}/schedule",
          "encoding": "json",
          "is_collection": true,
          "mapping": {
            "collection": "payments"
          }
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: создание счёта",
      "endpoint": "/api/v1/account",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://account:51054"
          ],
          "url_pattern": "/account",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: публикация события оповещения",
      "endpoint": "/api/v1/notify/events",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/events",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: лента оповещений с длинным опросом",
      "endpoint": "/api/v1/notify/messages",
      "method": "GET",
      "output_encoding": "no-op",
      "timeout": "30s",
      "input_query_strings": [
        "after",
        "limit",
        "wait"
      ],
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/messages",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: настройки оповещений",
      "endpoint": "/api/v1/notify/preferences",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/preferences",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: изменение настроек оповещений",
      "endpoint": "/api/v1/notify/preferences",
      "method": "PUT",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/preferences",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: код привязки Telegram",
      "endpoint": "/api/v1/notify/telegram/link",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Content-Length"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/telegram/link",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    },
    {
      "@comment": "Защищённый: состояние привязки Telegram",
      "endpoint": "/api/v1/notify/telegram",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "host": [
            "http://notify:51055"
          ],
          "url_pattern": "/notify/telegram",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "{{ env "AUTH_HOST" }}{{ env "AUTH_JWKS_PATH" }}",
          "disable_jwk_security": true,
          "cache": true,
          "propagate_claims": [
            [
              "sub",
              "X-Authorized-Id"
            ],
            [
              "{{ env "AUTH_ROLES_CLAIM" }}",
              "X-Roles"
            ]
          ]
        }
      }
    }
  ],
  "sequential_start": true,
  "extra_config": {
    "telemetry/metrics": {
      "collection_time": "30s",
      "listen_address": ":8090"
    },
    "telemetry/influx": {
      "address": "http://influxdb:8086",
      "ttl": "25s",
      "buffer_size": 100,
      "username": "{{ env "INFLUXDB_USER" }}",
      "password": "{{ env "INFLUXDB_PASSWORD" }}"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    },
    "telemetry/gelf": {
      "address": "logstash:12201",
      "enable_tcp": false
    },
    "telemetry/opencensus": {
      "sample_rate": 100,
      "reporting_period": 1,
      "enabled_layers": {
        "backend": true,
        "router": true
      },
      "exporters": {
        "jaeger": {
          "endpoint": "http://jaeger:14268/api/traces",
          "service_name": "krakend"
        }
      }
    },
    "security/cors": {
      "@comment": "Конкретные источники вместо *: со звёздочкой любой сайт может дёргать API от имени пользователя.",
      "allow_origins": [
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "allow_methods": [
        "GET",
        "POST"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [
        "Content-Length",
        "X-User-Id",
        "X-Credit-Id",
        "X-Account-Id"
      ],
      "allow_credentials": false,
      "max_age": "12h"
    },
    "auth/revoker": {
      "N": 10000000,
      "P": 0.0000001,
      "hash_name": "optimal",
      "TTL": 1500,
      "port": 1234,
      "token_keys": [
        "jti"
      ]
    }
  }
}
