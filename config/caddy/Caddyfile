# Обратный прокси перед стеком окружения.
#
# Единственное, что смотрит наружу. Сертификат Caddy получает и продлевает
# сам: для настоящего имени — через Let's Encrypt, для localhost и
# внутренних имён — своим удостоверяющим центром, поэтому этот же файл
# годится и для проверки на машине разработчика.
#
# Адрес задаётся переменной DOMAIN. Пусто здесь недопустимо: без имени
# Caddy слушает всё подряд и сертификат получить не может.
{
	# Порты внутри контейнера постоянны, наружу их отображает compose.
	http_port 80
	https_port 443
}

{$DOMAIN} {
	encode zstd gzip

	# Заголовки безопасности задаются здесь, а не в каждом сервисе:
	# точка входа одна, и место у них одно.
	header {
		# Год: срок меньше нескольких месяцев браузеры считают
		# ненадёжным обещанием.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Версия сервера и шлюза снаружи никому не нужна, кроме того,
		# кто подбирает уязвимость под неё.
		-Server
		-X-Krakend
		-X-Krakend-Completed
	}

	# API идёт через шлюз: это он проверяет токен и проставляет
	# X-Authorized-Id. Пускать сюда сервисы напрямую нельзя —
	# заголовок можно подделать, и тогда любой работает от чужого имени.
	handle /api/* {
		reverse_proxy krakend:8080
	}

	# Всё остальное — статика интерфейса.
	handle {
		reverse_proxy web:51058
	}
}
