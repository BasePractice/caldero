# Переменные окружения сервера. На машине лежат в файле .env рядом
# с compose.yml, а в GitHub — секретом окружения (ENV_FILE) целиком.
#
# Здесь только то, без чего стек не поднимется или поднимется небезопасно.
# Полный список переменных со значениями по умолчанию — в .env.example
# в корне репозитория.

# Реестр образов и выкатываемый тег. TAG подставляет доставка, здесь его
# держать не нужно.
REGISTRY=ghcr.io/basepractice/caldero

# Пароль базы. Порт наружу не публикуется, но пароль всё равно
# не должен быть словарным: доступ к базе есть у всего стека.
POSTGRES_PASSWORD=

# Ключ шифрования приватных ключей подписи в базе. Пустое значение
# оставляет их открытым текстом — на сервере это недопустимо.
KEY_MASTER_KEY=

# Ровно 32 байта: используется для шифрования сессий OAuth2.
OAUTH2_GLOBAL_SECRET=

# Имя, по которому окружение открывается снаружи. На него прокси получает
# сертификат: для настоящего имени — через Let's Encrypt, для localhost
# и внутренних имён — своим удостоверяющим центром.
DOMAIN=example.org

# Внешний адрес целиком. По нему дымовой сценарий проверяет стек
# после выката.
PUBLIC_URL=https://example.org

# Адреса, которые видит браузер. Издатель токенов обязан совпадать
# с тем, по которому клиент забирает JWKS, и оба обязаны быть https:
# по http токен уходит открытым текстом.
OAUTH2_ISSUER=https://example.org/api/v1
PUBLIC_BASE_URL=https://example.org
WEB_API_BASE=https://example.org/api/v1

# Метрики шлюза. Пустым оставлять нельзя: KrakenD не стартует.
INFLUXDB_PASSWORD=

# Порты прокси на машине. Больше стек наружу ничего не открывает.
# Разные у staging и production, если они живут на одной машине — но тогда
# и имена у них разные, а сертификат на нестандартном порту получить
# сложнее: перевыпуск по HTTP-01 требует именно 80-го.
HTTP_PORT=80
HTTPS_PORT=443

# Необязательное: каналы оповещений, внешние провайдеры входа,
# маркетплейсы. Пустые значения выключают соответствующий канал.
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_MAX_TOKEN=
SMTP_HOST=
EMAIL_FROM=
EMAIL_SECRET=
EMAIL_UNSUBSCRIBE_URL=
SOCIAL_PROVIDERS=
