### Create credit
POST {{credit.url}}/credit
Content-Type: application/json
X-Authorized-Id: {{credit.operator}}

{
  "user_id": "{{user_id}}",
  "percent": 24,
  "balance": 1200000000,
  "kind": "ANN",
  "type": "SIMPLE",
  "month": 360
}

> {%
    client.global.set("credit_id", response.headers.valueOf("X-Credit-Id"))
%}

### Get month payments
< {%
    request.variables.set("credit_id", client.global.get("credit_id"))
    client.log(client.global)
%}
GET {{credit.url}}/credit/{{credit_id}}/need_payments
Accept: application/json

