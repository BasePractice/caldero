# Конфигурация сервиса. Скопируйте в .env и поправьте под себя.
# Реальное окружение перекрывает .env, а .env.local перекрывает .env.

# Подключение к PostgreSQL. search_path задаёт схему сервиса:
# wallet | credit | account | users
DATABASE_URL=postgres://postgres:postgres@localhost:25432/wish?sslmode=disable&search_path=public

REDIS_URL=redis://localhost:6379/10?protocol=3

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Пустое значение — вывод в stdout. Непустое — JSON в указанный файл.
LOG_FILE=

# Цветной вывод в stdout. В контейнере имеет смысл выключить.
LOG_COLOR=true

# Порт служебного эндпоинта с метриками рантайма.
METRICS_PORT=8081

# Токен для служебных эндпоинтов сервиса users (/rotate-keys).
# Пустое значение полностью отключает их — это безопасный дефолт.
ADMIN_TOKEN=

# Минимальный интервал между ротациями ключей подписи.
KEY_ROTATION_MIN_INTERVAL=1h

# Секрет подписи OAuth2-токенов, ровно 32 байта. В режиме собственного
# провайдера (он теперь по умолчанию) без него токены не переживают рестарт,
# а два инстанса не проверят токены друг друга.
OAUTH2_GLOBAL_SECRET=

# Передавать клиенту внутренние детали ошибок OAuth2. Только для отладки.
OAUTH2_DEBUG=false

# Пул соединений с БД. Суммарно по всем сервисам должен укладываться
# в max_connections PostgreSQL (по умолчанию 100).
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Страница состояния рантайма (statsviz) на порту метрик. Не аутентифицирована,
# включать только для отладки.
DEBUG_STATSVIZ=false

# --- Провайдер аутентификации -------------------------------------------
# Точка переключения одна: какой JWKS считает доверенным API Gateway.
# Сервисы за шлюзом об этом не знают — они получают уже проверенный
# идентификатор в заголовке X-Authorized-Id. См. docs/adr/0001-auth-provider.md
#
# Режим собственного провайдера (по умолчанию), запуск: docker compose up
AUTH_HOST=http://users:51053
AUTH_JWKS_PATH=/.well-known/jwks.json
AUTH_TOKEN_PATH=/token
AUTH_ROLES_CLAIM=roles
#
# Режим Keycloak, запуск: docker compose --profile keycloak up
# AUTH_HOST=http://keycloak:8080
# AUTH_JWKS_PATH=/realms/krakend/protocol/openid-connect/certs
# AUTH_TOKEN_PATH=/realms/krakend/protocol/openid-connect/token
# AUTH_ROLES_CLAIM=realm_access.roles

# Значение claim iss в токенах собственного провайдера.
OAUTH2_ISSUER=http://localhost:8080/api/v1

# Как часто удалять просроченные токены. Ноль отключает очистку.
TOKEN_CLEANUP_INTERVAL=15m

# --- Секреты стенда ----------------------------------------------------
# Ни одно из значений ниже не имеет значения по умолчанию: compose откажется
# стартовать, пока они не заданы. Это сделано намеренно — раньше пароли лежали
# в docker-compose.yml открытым текстом и попадали в репозиторий.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=смените-меня
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=смените-меня
GRAFANA_ADMIN_PASSWORD=смените-меня
INFLUXDB_USER=krakend-dev
INFLUXDB_PASSWORD=смените-меня
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=смените-меня

# Уровень логирования Keycloak.
KC_LOG_LEVEL=INFO

# Мастер-ключ шифрования приватных ключей подписи в БД. Без него ключи
# хранятся открытым текстом, и дампа базы достаточно, чтобы подделать
# любой токен. Длина произвольная.
KEY_MASTER_KEY=

# Приёмник трасс по OTLP/HTTP. Пустое значение отключает трассировку.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Доля выгружаемых трасс, от 0 до 1.
OTEL_TRACES_SAMPLER_ARG=1.0
