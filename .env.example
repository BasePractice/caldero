# Конфигурация сервиса. Скопируйте в .env и поправьте под себя.
# Реальное окружение перекрывает .env, а .env.local перекрывает .env.

# Подключение к PostgreSQL. search_path задаёт схему сервиса:
# wallet | credit | account | users
DATABASE_URL=postgres://postgres:postgres@localhost:25432/wish?sslmode=disable&search_path=public

REDIS_URL=redis://localhost:6379/10?protocol=3

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Пустое значение — вывод в stdout. Непустое — JSON в указанный файл.
LOG_FILE=

# Цветной вывод в stdout. В контейнере имеет смысл выключить.
LOG_COLOR=true

# Порт служебного эндпоинта с метриками рантайма.
METRICS_PORT=8081
